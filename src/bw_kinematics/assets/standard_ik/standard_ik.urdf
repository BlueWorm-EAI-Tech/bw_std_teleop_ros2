<?xml version="1.0"?>
<!-- IK-only model derived from mantis_description/urdf/standard.urdf.
     It keeps only the waist and two seven-axis arm chains so Pinocchio has
     14 nq after the waist is locked. -->
<robot name="standard_ik">
  <!-- VR reset/target poses for standard are defined relative to C_Link, so
       C_Link is the IK root. C_joint remains as a lockable non-arm branch. -->
  <link name="C_Link"/>
  <link name="base_link"/>
  <joint name="C_joint" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="C_Link"/><child link="base_link"/>
    <axis xyz="0.000506870682816193 0 0.999999871541047"/>
    <limit lower="-0.5" upper="0.0" effort="1000" velocity="1"/>
  </joint>

  <link name="A_left_Degree1_link"/><link name="A_left_Degree2_link"/>
  <link name="A_left_Degree3_link"/><link name="A_left_Degree4_link"/>
  <link name="A_left_Degree5_link"/><link name="A_left_Degree6_link"/>
  <link name="A_left_Degree7_link"/>
  <joint name="A_left_Degree1_joint" type="revolute">
    <origin xyz="0.0769782744545503 0.082995695464067 -0.00591929831752525" rpy="0 0 0"/>
    <parent link="C_Link"/><child link="A_left_Degree1_link"/><axis xyz="0 1 0"/>
    <limit lower="-2.069" upper="1.022" effort="1000" velocity="10"/>
  </joint>
  <joint name="A_left_Degree2_joint" type="revolute">
    <origin xyz="-0.04349999441204076 0.09600000000000418 2.204887470264551e-05" rpy="0 0 0"/>
    <parent link="A_left_Degree1_link"/><child link="A_left_Degree2_link"/><axis xyz="1 0 0"/>
    <limit lower="-0.142" upper="2.077" effort="1000" velocity="10"/>
  </joint>
  <joint name="A_left_Degree3_joint" type="revolute">
    <origin xyz="0.08350023003696787 0 0.0004576821067593415" rpy="0 0 0"/>
    <parent link="A_left_Degree2_link"/><child link="A_left_Degree3_link"/><axis xyz="0 0 1"/>
    <limit lower="-1.541" upper="1.541" effort="1000" velocity="10"/>
  </joint>
  <joint name="A_left_Degree4_joint" type="revolute">
    <origin xyz="-0.0001140199226370478 0.03400000961672196 -0.2254999674069031" rpy="0 0 0"/>
    <parent link="A_left_Degree3_link"/><child link="A_left_Degree4_link"/><axis xyz="0 1 0"/>
    <limit lower="-0.529" upper="1.355" effort="1000" velocity="10"/>
  </joint>
  <joint name="A_left_Degree5_joint" type="revolute">
    <origin xyz="0.1040000027028259 -0.03400001557480561 -5.271461263612263e-05" rpy="0 0 0"/>
    <parent link="A_left_Degree4_link"/><child link="A_left_Degree5_link"/><axis xyz="1 0 0"/>
    <limit lower="-1.540" upper="1.540" effort="1000" velocity="10"/>
  </joint>
  <!-- Degree6/7 keep the same chain order and transforms as standard.urdf. -->
  <joint name="A_left_Degree6_joint" type="revolute">
    <origin xyz="0.10899995384968593235 0.022499994706963546508547 -0.00005524771126081" rpy="0 0 0"/>
    <parent link="A_left_Degree5_link"/><child link="A_left_Degree6_link"/><axis xyz="0 1 0"/>
    <limit lower="-0.756" upper="0.756" effort="1000" velocity="10"/>
  </joint>
  <joint name="A_left_Degree7_joint" type="revolute">
    <origin xyz="-0.00001654299283043235 -0.02249999997592419 -0.03269999583197195" rpy="0 0 0"/>
    <parent link="A_left_Degree6_link"/><child link="A_left_Degree7_link"/><axis xyz="0 0 1"/>
    <limit lower="-1.017" upper="1.018" effort="1000" velocity="10"/>
  </joint>

  <link name="A_right_Degree1_link"/><link name="A_right_Degree2_link"/>
  <link name="A_right_Degree3_link"/><link name="A_right_Degree4_link"/>
  <link name="A_right_Degree5_link"/><link name="A_right_Degree6_link"/>
  <link name="A_right_Degree7_link"/>
  <joint name="A_right_Degree1_joint" type="revolute">
    <origin xyz="0.0769782677791134 -0.08300429589760019 -0.00591928425117105" rpy="0 0 0"/>
    <parent link="C_Link"/><child link="A_right_Degree1_link"/><axis xyz="0 1 0"/>
    <limit lower="-2.069" upper="1.022" effort="1000" velocity="10"/>
  </joint>
  <joint name="A_right_Degree2_joint" type="revolute">
    <origin xyz="-0.03849999505431746 -0.09599999999998944 1.95145212884166e-05" rpy="0 0 0"/>
    <parent link="A_right_Degree1_link"/><child link="A_right_Degree2_link"/><axis xyz="1 0 0"/>
    <limit lower="-2.077" upper="0.142" effort="1000" velocity="10"/>
  </joint>
  <joint name="A_right_Degree3_joint" type="revolute">
    <origin xyz="0.07849770885655612 -1.007652606102994e-06 -0.004539788535956208" rpy="0 0 0"/>
    <parent link="A_right_Degree2_link"/><child link="A_right_Degree3_link"/><axis xyz="0 0 1"/>
    <limit lower="-1.541" upper="1.541" effort="1000" velocity="10"/>
  </joint>
  <joint name="A_right_Degree4_joint" type="revolute">
    <origin xyz="-0.0001117653620362219 0.03399999999974442 -0.2204999716804573" rpy="0 0 0"/>
    <parent link="A_right_Degree3_link"/><child link="A_right_Degree4_link"/><axis xyz="0 1 0"/>
    <limit lower="-0.529" upper="1.355" effort="1000" velocity="10"/>
  </joint>
  <joint name="A_right_Degree5_joint" type="revolute">
    <origin xyz="0.1039999866488944 -0.03399999997365324 -5.271454696834708e-05" rpy="0 0 0"/>
    <parent link="A_right_Degree4_link"/><child link="A_right_Degree5_link"/><axis xyz="1 0 0"/>
    <limit lower="-1.540" upper="1.540" effort="1000" velocity="10"/>
  </joint>
  <joint name="A_right_Degree6_joint" type="revolute">
    <origin xyz="0.1089999821282742027 -0.02249999997237573902087284 -0.00005524889824318" rpy="0 0 0"/>
    <parent link="A_right_Degree5_link"/><child link="A_right_Degree6_link"/><axis xyz="0 1 0"/>
    <limit lower="-0.756" upper="0.756" effort="1000" velocity="10"/>
  </joint>
  <joint name="A_right_Degree7_joint" type="revolute">
    <origin xyz="-0.0000165708003660027 0.02249999999995746 -0.03269999580137573" rpy="0 0 0"/>
    <parent link="A_right_Degree6_link"/><child link="A_right_Degree7_link"/><axis xyz="0 0 1"/>
    <limit lower="-1.017" upper="1.018" effort="1000" velocity="10"/>
  </joint>
</robot>
