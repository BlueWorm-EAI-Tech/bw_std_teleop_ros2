<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 受控关节使用统一接口-->
  <xacro:macro name="standard_position_joint" params="joint_name lower upper initial_value:=0.0">
    <joint name="${joint_name}">
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_value}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="standard_ros2_control"
               params="name use_mock_hardware serial_port baud_rate feedback_timeout_ms power_on_on_activate arm_mapping_calibrated left_arm_motor_indices right_arm_motor_indices left_arm_direction right_arm_direction left_arm_raw_zero_rad right_arm_raw_zero_rad arm_max_velocity_rad_s pelvis_max_velocity_mm_s gripper_max_velocity_normalized_s arm_startup_limit_tolerance_rad gripper_startup_limit_tolerance_m head_max_velocity_rad_s command_rate_hz">
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">false</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>bw_std_control/StandardSystemHardware</plugin>
          <param name="serial_port">${serial_port}</param>
          <param name="baud_rate">${baud_rate}</param>
          <param name="feedback_timeout_ms">${feedback_timeout_ms}</param>
          <param name="power_on_on_activate">${str(power_on_on_activate).lower()}</param>
          <param name="arm_mapping_calibrated">${str(arm_mapping_calibrated).lower()}</param>
          <param name="left_arm_motor_indices">${left_arm_motor_indices}</param>
          <param name="right_arm_motor_indices">${right_arm_motor_indices}</param>
          <param name="left_arm_direction">${left_arm_direction}</param>
          <param name="right_arm_direction">${right_arm_direction}</param>
          <param name="left_arm_raw_zero_rad">${left_arm_raw_zero_rad}</param>
          <param name="right_arm_raw_zero_rad">${right_arm_raw_zero_rad}</param>
          <param name="arm_max_velocity_rad_s">${arm_max_velocity_rad_s}</param>
          <param name="pelvis_max_velocity_mm_s">${pelvis_max_velocity_mm_s}</param>
          <param name="gripper_max_velocity_normalized_s">${gripper_max_velocity_normalized_s}</param>
          <param name="arm_startup_limit_tolerance_rad">${arm_startup_limit_tolerance_rad}</param>
          <param name="gripper_startup_limit_tolerance_m">${gripper_startup_limit_tolerance_m}</param>
          <param name="head_max_velocity_rad_s">${head_max_velocity_rad_s}</param>
          <param name="command_rate_hz">${command_rate_hz}</param>
        </xacro:unless>
      </hardware>

      <!-- 左右臂各 7 轴，限位与几何模型保持一致。 -->
      <xacro:standard_position_joint joint_name="A_left_Degree1_joint" lower="-2.069" upper="1.022"/>
      <xacro:standard_position_joint joint_name="A_left_Degree2_joint" lower="-0.142" upper="2.077"/>
      <xacro:standard_position_joint joint_name="A_left_Degree3_joint" lower="-1.541" upper="1.541"/>
      <xacro:standard_position_joint joint_name="A_left_Degree4_joint" lower="-0.529" upper="1.355"/>
      <xacro:standard_position_joint joint_name="A_left_Degree5_joint" lower="-1.540" upper="1.540"/>
      <xacro:standard_position_joint joint_name="A_left_Degree6_joint" lower="-0.756" upper="0.756"/>
      <xacro:standard_position_joint joint_name="A_left_Degree7_joint" lower="-1.017" upper="1.018"/>

      <xacro:standard_position_joint joint_name="A_right_Degree1_joint" lower="-2.069" upper="1.022"/>
      <xacro:standard_position_joint joint_name="A_right_Degree2_joint" lower="-2.077" upper="0.142"/>
      <xacro:standard_position_joint joint_name="A_right_Degree3_joint" lower="-1.541" upper="1.541"/>
      <xacro:standard_position_joint joint_name="A_right_Degree4_joint" lower="-0.529" upper="1.355"/>
      <xacro:standard_position_joint joint_name="A_right_Degree5_joint" lower="-1.540" upper="1.540"/>
      <xacro:standard_position_joint joint_name="A_right_Degree6_joint" lower="-0.756" upper="0.756"/>
      <xacro:standard_position_joint joint_name="A_right_Degree7_joint" lower="-1.017" upper="1.018"/>

      <!-- Degree9 由 URDF mimic 驱动，不占用独立硬件接口。 -->
      <xacro:standard_position_joint joint_name="A_left_Degree8_joint" lower="0.0" upper="0.04965"/>
      <xacro:standard_position_joint joint_name="A_right_Degree8_joint" lower="0.0" upper="0.04965"/>
      <xacro:standard_position_joint
        joint_name="C_joint"
        lower="-0.5"
        upper="0.0"
        initial_value="-0.1"/>

      <!-- 真机与 mock 共用机体速度 GPIO -->
      <gpio name="base">
        <command_interface name="vx"/>
        <command_interface name="vy"/>
        <command_interface name="wz"/>
      </gpio>

      <!-- 头部导出 command-only GPIO -->
      <gpio name="head">
        <command_interface name="pitch">
          <param name="min">-0.524</param>
          <param name="max">0.785</param>
        </command_interface>
        <command_interface name="yaw">
          <param name="min">-1.570</param>
          <param name="max">1.570</param>
        </command_interface>
        <command_interface name="roll">
          <param name="min">-0.349</param>
          <param name="max">0.349</param>
        </command_interface>
      </gpio>

      <!-- 安全 GPIO: 遥操作控制活跃请求 1; VR 断流后请求 0 触发软件掉电。 -->
      <gpio name="safety">
        <command_interface name="power">
          <param name="min">0</param>
          <param name="max">1</param>
        </command_interface>
      </gpio>
    </ros2_control>
  </xacro:macro>
</robot>
